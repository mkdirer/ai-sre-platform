{
  "schema_version": "1.0",
  "scenario_id": "SCN-002",
  "scenario_version": 1,
  "dataset_version": "v1",
  "title": "Database pool exhaustion",
  "description": "Payment DB pool saturated with bounded wait-queue delay; pool usage metric plus pool log and trace markers support the cause.",
  "fault": {
    "name": "pool_exhaustion",
    "service": "payment-service",
    "control_path": "/internal/faults/pool-exhaustion",
    "expect_alert": false,
    "alertname": ""
  },
  "deployments": [
    {
      "service": "payment-service",
      "environment": "development",
      "version": "0.0.9",
      "deployed_at_offset_minutes": -90,
      "commit_sha": "1111111111111111111111111111111111111111",
      "role": "previous_baseline"
    },
    {
      "service": "payment-service",
      "environment": "development",
      "version": "0.1.0",
      "deployed_at_offset_minutes": -10,
      "commit_sha": "2222222222222222222222222222222222222222",
      "role": "current_baseline"
    }
  ],
  "expectation": {
    "affected_service": "payment-service",
    "accepted_root_causes": ["db_pool_saturation"],
    "contradicted_causes": ["bad_deployment", "cpu_saturation"],
