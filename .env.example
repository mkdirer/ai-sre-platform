# Copy this file to .env for local development. Never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0

# Compose enables OTLP export to its internal Collector. For host-run services, use
# http://127.0.0.1:4317 instead.
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORT_TIMEOUT_SECONDS=2.0
OTEL_BATCH_SCHEDULE_DELAY_MILLISECONDS=500

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aisre
POSTGRES_USER=aisre
# Local placeholder only; replace it before connecting to a database.
POSTGRES_PASSWORD=change-me
DATABASE_CONNECT_TIMEOUT_SECONDS=3.0

# Durable queue. URLs are secret-safe in settings and point to separate broker/result DBs.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/1
QUEUE_PUBLISH_TIMEOUT_SECONDS=2.0
INVESTIGATION_MAX_ATTEMPTS=3
INVESTIGATION_RETRY_BASE_SECONDS=2
INVESTIGATION_RETRY_MAX_SECONDS=30
INVESTIGATION_JOB_LEASE_SECONDS=15
CELERY_VISIBILITY_TIMEOUT_SECONDS=300

# Stage 05 read-only evidence adapters. Compose overrides the three backend URLs for the worker.
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200
EVIDENCE_HTTP_TIMEOUT_SECONDS=2.0
EVIDENCE_HTTP_MAX_ATTEMPTS=2
EVIDENCE_HTTP_RETRY_BACKOFF_SECONDS=0.05
EVIDENCE_SOURCE_TIMEOUT_SECONDS=8.0
EVIDENCE_MAX_RESPONSE_BYTES=2097152
EVIDENCE_MAX_WINDOW_SECONDS=3600
EVIDENCE_MAX_LOOKBACK_SECONDS=21600
EVIDENCE_FUTURE_SKEW_SECONDS=300
EVIDENCE_DEPLOYMENT_LOOKBACK_SECONDS=7200
EVIDENCE_METRIC_STEP_SECONDS=5
EVIDENCE_LOG_LIMIT=50
EVIDENCE_TRACE_LIMIT=10
EVIDENCE_DEPLOYMENT_LIMIT=10
EVIDENCE_CORRELATION_LIMIT=1000
EVIDENCE_SLOW_TRACE_THRESHOLD_MS=500

OUTBOUND_HTTP_TIMEOUT_SECONDS=5.0
OUTBOUND_HTTP_MAX_ATTEMPTS=2
OUTBOUND_HTTP_RETRY_BACKOFF_SECONDS=0.05
ORDER_SERVICE_URL=http://127.0.0.1:8002
INVENTORY_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

INVENTORY_SKU=widget-001
INVENTORY_STOCK=100
INVENTORY_UNIT_PRICE_CENTS=1999

# Local Stage 03 fault control. The process still initializes the fault disabled;
# production is denied even if these values are copied there.
FAULT_INJECTION_ALLOWED=false
FAULT_CONTROL_TOKEN=local-demo-fault-control
SLOW_DATABASE_DELAY_SECONDS=2.5

# Host bindings used by Docker Compose.
GATEWAY_PORT=8001
ORDER_SERVICE_PORT=8002
INVENTORY_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
ALERT_RECEIVER_PORT=8005
INCIDENT_API_PORT=8006
INVESTIGATOR_METRICS_PORT=9464
REDIS_PORT=6379
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Optional smoke-runner overrides.
SMOKE_GATEWAY_URL=http://127.0.0.1:8001
SMOKE_PAYMENT_URL=http://127.0.0.1:8004
SMOKE_REQUEST_COUNT=1
SMOKE_PROMETHEUS_URL=http://127.0.0.1:9090
SMOKE_LOKI_URL=http://127.0.0.1:3100
SMOKE_TEMPO_URL=http://127.0.0.1:3200
SMOKE_OTEL_COLLECTOR_URL=http://127.0.0.1:13133

# Optional controlled-scenario overrides. The token is never printed by the runner.
SCENARIO_FAULT_CONTROL_TOKEN=local-demo-fault-control
SCENARIO_ALERTMANAGER_URL=http://127.0.0.1:9093
SCENARIO_ALERT_RECEIVER_URL=http://127.0.0.1:8005
SCENARIO_INCIDENT_API_URL=http://127.0.0.1:8006
SCENARIO_TRAFFIC_COUNT=8

# Optional integration-test overrides; export them or pass them to Make explicitly.
TEST_GATEWAY_URL=http://127.0.0.1:8001
TEST_PAYMENT_URL=http://127.0.0.1:8004
TEST_PROMETHEUS_URL=http://127.0.0.1:9090
TEST_LOKI_URL=http://127.0.0.1:3100
TEST_TEMPO_URL=http://127.0.0.1:3200
TEST_ALERTMANAGER_URL=http://127.0.0.1:9093
TEST_INCIDENT_API_URL=http://127.0.0.1:8006
TEST_INVESTIGATOR_METRICS_URL=http://127.0.0.1:9464/metrics
TEST_DATABASE_URL=postgresql+asyncpg://aisre:change-me@127.0.0.1:5432/aisre_test
LIVE_DATABASE_URL=postgresql+asyncpg://aisre:change-me@127.0.0.1:5432/aisre
RUN_LOCAL_EVIDENCE_INTEGRATION=false
