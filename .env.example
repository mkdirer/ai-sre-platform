# Copy this file to .env for local development. Never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aisre
POSTGRES_USER=aisre
# Local placeholder only; replace it before connecting to a database.
POSTGRES_PASSWORD=change-me
DATABASE_CONNECT_TIMEOUT_SECONDS=3.0

OUTBOUND_HTTP_TIMEOUT_SECONDS=5.0
OUTBOUND_HTTP_MAX_ATTEMPTS=2
OUTBOUND_HTTP_RETRY_BACKOFF_SECONDS=0.05
ORDER_SERVICE_URL=http://127.0.0.1:8002
INVENTORY_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

INVENTORY_SKU=widget-001
INVENTORY_STOCK=100
INVENTORY_UNIT_PRICE_CENTS=1999

# Host bindings used by Docker Compose.
GATEWAY_PORT=8001
ORDER_SERVICE_PORT=8002
INVENTORY_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004

# Optional smoke-runner overrides.
SMOKE_GATEWAY_URL=http://127.0.0.1:8001
SMOKE_PAYMENT_URL=http://127.0.0.1:8004
SMOKE_REQUEST_COUNT=1

# Optional integration-test overrides; export them or pass them to Make explicitly.
TEST_GATEWAY_URL=http://127.0.0.1:8001
TEST_PAYMENT_URL=http://127.0.0.1:8004
TEST_DATABASE_URL=postgresql+asyncpg://aisre:change-me@127.0.0.1:5432/aisre_test
LIVE_DATABASE_URL=postgresql+asyncpg://aisre:change-me@127.0.0.1:5432/aisre
